# ---- Porchlight backend configuration (copy to backend/.env) ----

# Identity shown to members and volunteers
COMMUNITY_NAME=Maryvale Neighbors Network
COORDINATOR_NAME=Block Captain
# Public URL of the frontend; check-in links are built from this
PUBLIC_BASE_URL=http://localhost:5173

# ---- Model provider (Strands Agents SDK) ----
# auto = Bedrock first, then Anthropic API, then Ollama (fallback via strands ModelRouter)
MODEL_PROVIDER=auto
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1
# AWS credentials come from the standard chain (aws configure / env vars / IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Or a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=
# Optional fallbacks
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_NUM_CTX=16384

# ---- Hazard detection ----
NWS_USER_AGENT=porchlight (you@example.com)
SENTINEL_INTERVAL_MINUTES=15
FOLLOWUP_INTERVAL_MINUTES=2
FOLLOWUP_GRACE_MINUTES=20
HEAT_INDEX_ACTIVATE_F=105
AQI_ACTIVATE=151
COLD_ACTIVATE_F=15

# ---- Outbound channels ----
# console = log only (development). live = send through configured providers.
SEND_MODE=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# TELEGRAM_BOT_TOKEN=
# SES_FROM_EMAIL=
# Demo: route every outbound message to one phone/chat/email you control
# DEMO_OVERRIDE_PHONE=+1...
# DEMO_OVERRIDE_TELEGRAM_CHAT_ID=
# DEMO_OVERRIDE_EMAIL=

# ---- Policy ----
AUTO_APPROVE_ESCALATIONS=false

# ---- Server ----
PORT=8000
CORS_ORIGINS=*

# ---- Memory ----
# Neighbor history across episodes always works locally (SQLite). Optionally mirror outcomes and coordinator
# lessons to Amazon Bedrock AgentCore Memory for long-term, LLM-distilled memories per neighbor.
# Create the resource once: python scripts/create_agentcore_memory.py --region us-east-1  (prints the id)
# AGENTCORE_MEMORY_ID=
# Namespace template the memory's strategies write to (default matches the create script)
# AGENTCORE_MEMORY_NAMESPACE=/porchlight/neighbors/{actorId}/
