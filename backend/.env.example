# ---- Porchlight backend configuration (copy to backend/.env) ----

# Identity shown to members and volunteers
COMMUNITY_NAME=Maryvale Neighbors Network
COORDINATOR_NAME=Block Captain
# Public URL of the frontend; check-in links are built from this
PUBLIC_BASE_URL=http://localhost:5173

# ---- Model provider (Strands Agents SDK) ----
# auto = Bedrock first, then the Anthropic API (fallback via strands ModelRouter)
MODEL_PROVIDER=auto
# Amazon Nova is a Bedrock first-party model and needs no per-account use case form, so a fresh AWS
# account can run Porchlight immediately. Anthropic models are a drop-in swap once that form is
# approved for the account: change this line and nothing else.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AWS_REGION=us-east-1
# AWS credentials come from the standard chain (aws configure / env vars / IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Or a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=
# Optional fallbacks
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=
# MODEL_TEMPERATURE=
# Optional third-party router, used only if MODEL_PROVIDER=tokenrouter or as a last fallback
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=
# TOKENROUTER_MODEL_ID=
# TOKENROUTER_REASONING_EFFORT=

# ---- Hazard detection ----
NWS_USER_AGENT=porchlight (you@example.com)
SENTINEL_INTERVAL_MINUTES=15
FOLLOWUP_INTERVAL_MINUTES=2
FOLLOWUP_GRACE_MINUTES=20
HEAT_INDEX_ACTIVATE_F=105
AQI_ACTIVATE=151
COLD_ACTIVATE_F=15

# ---- Outbound channels ----
# console = log only (development). live = send through configured providers.
SEND_MODE=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# # Fastest live channel for a demo: message @BotFather on Telegram, send /newbot, paste the token here,
# then run `python scripts/telegram_setup.py` to learn your chat id and send yourself a real test message.
TELEGRAM_BOT_TOKEN=
# SES_FROM_EMAIL=
# Demo: route every outbound message to one phone/chat/email you control
# DEMO_OVERRIDE_PHONE=+1...
# DEMO_OVERRIDE_TELEGRAM_CHAT_ID=
# DEMO_OVERRIDE_EMAIL=
# With an override set, DEMO_LIVE_MEMBER_ID limits real sending to ONE neighbour: that person's messages
# go to your device and everyone else is logged. Without it, a twelve-person roster sends you twelve
# messages at once. Set this before recording anything.
# DEMO_LIVE_MEMBER_ID=mem_bettie
# Seconds the Telegram reply listener long-polls for
# TELEGRAM_POLL_WAIT_S=25

# ---- Reminders ----
# A neighbour who does not reply is reminded MAX_REMINDERS times, REMINDER_GAP_MINUTES apart, counted
# per person across every open episode. One reply closes all of them. After the last reminder goes
# unanswered Porchlight stops texting and marks them critical for the coordinator, because silence from
# someone at risk is the finding rather than a reason to send another message.
MAX_REMINDERS=3
REMINDER_GAP_MINUTES=3

# ---- Policy ----
AUTO_APPROVE_ESCALATIONS=false

# ---- Server ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
# Where the SQLite database, sessions and generated audio live
# DATA_DIR=data
# Set false to stop the background hazard scan (useful while developing)
# SENTINEL_ENABLED=true

# ---- Agent time budget ----
# A node normally finishes in seconds on Bedrock. Raise these only if you point the agents at a slow
# provider, where a single triage node over a dozen neighbours can take minutes rather than seconds.
NODE_TIMEOUT_S=900
GRAPH_TIMEOUT_S=1800

# ---- Voice calls (Twilio Programmable Voice + Amazon Polly voices) ----
# Uses the same TWILIO_* credentials above. Members with preferred_channel=voice get a real phone call that reads
# the call script (Polly.Joanna / Polly.Lupe) and asks them to press 1 (I'm OK) or 2 (I need help).
# PUBLIC_BASE_URL must be reachable by Twilio (e.g. an ngrok/cloudflared tunnel) for keypresses to arrive.
# Skip Twilio webhook signature checks when testing locally with curl (never in production):
# VOICE_SKIP_SIGNATURE=false
# ---- Memory ----
# Neighbor history across episodes always works locally (SQLite). Optionally mirror outcomes and coordinator
# lessons to Amazon Bedrock AgentCore Memory for long-term, LLM-distilled memories per neighbor.
# Create the resource once: python scripts/create_agentcore_memory.py --region us-east-1  (prints the id)
# AGENTCORE_MEMORY_ID=
# Namespace template the memory's strategies write to (default matches the create script)
# AGENTCORE_MEMORY_NAMESPACE=/porchlight/neighbors/{actorId}/
